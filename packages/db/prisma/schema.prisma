// Datamodel — zie docs/architectuurvoorstel.md voor de motivatie per keuze.
// Organization (1 rij nu) -> Event -> Product (kind: TICKET/MERCHANDISE) -> Order ->
// OrderItem -> Ticket -> CheckIn, plus User, EmailTemplate, PageBlock, Setting en AuditLog.
// Een ticket is gewoon een Product met kind=TICKET — alleen die regels genereren een
// scanbaar Ticket. Zie docs/architectuurvoorstel.md ("Fase 5 — één Product-model").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  UNUSED
  CHECKED_IN
  CANCELLED
}

enum UserRole {
  ADMIN
  FINANCE
  EDITOR
  DOOR_STAFF
}

enum EmailTemplateType {
  ORDER_CONFIRMATION
  PAYMENT_REMINDER
  PAYMENT_FAILED
  CANCELLED
}

enum ProductKind {
  TICKET
  MERCHANDISE
  DONATION
}

enum EmailCampaignStatus {
  QUEUED
  SENDING
  DONE
}

enum EmailCampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPTOUT
}

model Organization {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  events                     Event[]
  users                      User[]
  settings                   Setting[]
  auditLogs                  AuditLog[]
  emailCampaigns             EmailCampaign[]
  emailLayouts               EmailLayout[]
  mailingTemplates           MailingTemplate[]
  customPlaceholders         CustomPlaceholder[]
  systemPlaceholderOverrides SystemPlaceholderOverride[]
  contacts                   Contact[]
  createdAt                  DateTime                    @default(now())

  @@map("organizations")
}

enum ContactSource {
  ORDER
  IMPORT
}

// Org-breed, niet event-gebonden adresboek: de opt-in doelgroep voor mailings los van één
// specifiek event (zie CampaignSegment "ADDRESS_BOOK", packages/core/src/email/segment.ts).
// Gevuld vanuit twee bronnen — bestaande, opt-in kopers (syncOrderContactsIntoAddressBook)
// en handmatige CSV-import van contacten van buiten deze app (importContacts) — uniek op
// e-mailadres per organisatie, dus een contact dat via beide wegen binnenkomt telt maar
// één keer mee.
model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  source         ContactSource
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("contacts")
}

model Event {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  slug           String          @unique
  name           String
  description    String?
  venue          String?
  startsAt       DateTime
  endsAt         DateTime?
  status         EventStatus     @default(DRAFT)
  // Vrije-vorm huisstijl per event (bv. { primaryColor, backgroundColor, accentColor,
  // logoUrl }) — zelfde Json-patroon als PageBlock.content, zodat een nieuwe thema-optie
  // geen migratie kost. Zie docs/architectuurvoorstel.md ("Per-event huisstijl").
  theme          Json?
  // Of dit event in de dagelijkse admin-pickers verschijnt (dashboard, e-mailtemplates,
  // paginabeheer) — los van `status`, dat de publieke zichtbaarheid regelt. `/events`
  // zelf en de bestellingen-filter tonen altijd alles, ook onzichtbare events.
  isVisible      Boolean         @default(true)
  products       Product[]
  bundles        ProductBundle[]
  orders         Order[]
  emailTemplates EmailTemplate[]
  emailCampaigns EmailCampaign[]
  pageBlocks     PageBlock[]
  userAccess     EventAccess[]
  songRequests   SongRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@map("events")
}

// Een verkoopbaar artikel binnen een event. kind=TICKET-regels genereren bij betaling een
// scanbaar Ticket (QR/check-in); kind=MERCHANDISE-regels niet — die komen alleen als
// vermelding op het ticket-PDF/de bevestigingsmail. Zie docs/architectuurvoorstel.md
// ("Fase 5 — één Product-model").
model Product {
  id                   String      @id @default(cuid())
  eventId              String
  event                Event       @relation(fields: [eventId], references: [id])
  kind                 ProductKind @default(MERCHANDISE)
  name                 String
  description          String?
  imageUrl             String?
  priceCents           Int
  currency             String      @default("EUR")
  totalStock           Int
  reservedStock        Int         @default(0)
  soldStock            Int         @default(0)
  isActive             Boolean     @default(true)
  // Alleen relevant voor kind=DONATION: de 3 voorgestelde bedragen (in centen) die als
  // knoppen op de site verschijnen naast het vrij-in-te-vullen "ander bedrag"-veld. Voor
  // TICKET/MERCHANDISE altijd leeg. Zie packages/core/src/checkout/donation.ts voor de
  // (server-side gevalideerde) minimumgrens van een vrij bedrag.
  donationPresetsCents Int[]       @default([])
  orderItems           OrderItem[]
  tickets              Ticket[]
  bundleItems          ProductBundleItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([eventId])
  @@map("products")
}

// Eén koopbaar "combi"-artikel (bv. Ticket + Glowstick) tegen één gezamenlijke prijs. Heeft
// bewust GEEN eigen voorraadtellers: bij aankoop valt een combi (create-order.ts) uiteen in
// losse OrderItems tegen de échte onderliggende Producten, zodat voorraad, ticketuitgifte en
// dashboardcijfers automatisch via de bestaande per-Product-logica blijven lopen i.p.v. een
// tweede, los bij te houden voorraadpotje. Beschikbaarheid wordt daarom altijd live afgeleid
// van de onderliggende producten (zie packages/core/src/products/bundles.ts).
model ProductBundle {
  id          String              @id @default(cuid())
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id])
  name        String
  description String?
  imageUrl    String?
  priceCents  Int
  currency    String              @default("EUR")
  isActive    Boolean             @default(true)
  items       ProductBundleItem[]
  orderItems  OrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([eventId])
  @@map("product_bundles")
}

// Hoeveel stuks van welk Product in één eenheid van de combi zitten (bv. 1x Ticket + 1x
// Glowstick). `quantity` is bewust bijna altijd 1 — bij een hogere waarde wordt de
// prijsverdeling per stuk (create-order.ts) op de cent afgerond, verwaarloosbaar voor de
// bedoelde combi's.
model ProductBundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([bundleId, productId])
  @@index([productId])
  @@map("product_bundle_items")
}

model Order {
  id                 String      @id @default(cuid())
  eventId            String
  event              Event       @relation(fields: [eventId], references: [id])
  buyerName          String
  buyerEmail         String
  status             OrderStatus @default(PENDING)
  totalCents         Int
  currency           String      @default("EUR")
  molliePaymentId    String?     @unique
  stockHoldExpiresAt DateTime?
  isVisible          Boolean     @default(true)
  // Welke mailing (indien van toepassing) tot deze bestelling heeft geleid — zie
  // {{ticketlink}} in packages/core/src/email/bulk-campaign.ts en het feest_ref-cookie
  // in apps/web/middleware.ts. SetNull i.p.v. blokkeren: een verwijderde mailing mag een
  // oude bestelling niet onverwijderbaar maken.
  mailingCampaignId  String?
  mailingCampaign    EmailCampaign? @relation(fields: [mailingCampaignId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  tickets            Ticket[]
  songRequests       SongRequest[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([eventId])
  @@index([status, stockHoldExpiresAt])
  @@index([isVisible])
  @@index([mailingCampaignId])
  @@map("orders")
}

// Muziekverzoeken voor de avond zelf: elke koper met tickets krijgt in de
// orderbevestiging een unieke link (packages/core/src/song-requests) waarmee ze max. 2
// nummers kunnen aanvragen (verzoeken/actions.ts). requesterName wordt gedenormaliseerd
// vanaf Order.buyerName opgeslagen, zodat de ranglijst in de admin (song-requests/page.tsx)
// niet voor elke rij terug hoeft te joinen naar Order.
model SongRequest {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  requesterName String
  artist        String
  title         String
  // Op inactief gezet vanuit de admin (bv. al gedraaid op het feest) — verdwijnt dan uit de
  // ranglijst (ook de DJ-pagina) en de afdeling Inactief, van waaruit het definitief
  // verwijderd kan worden. Zelfde "inactief i.p.v. direct verwijderen"-patroon als
  // Order.isVisible/Product.isVisible.
  isVisible     Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([orderId])
  @@map("song_requests")
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  // Gezet wanneer deze regel het resultaat is van het "uit elkaar vallen" van een
  // ProductBundle-aankoop (create-order.ts) — puur informatief voor weergave (bv. admin/
  // orderdetail), telt niet mee in voorraad-/ticketlogica (die loopt via `product` hierboven).
  // SetNull i.p.v. blokkeren: een later verwijderde combi mag een oude bestelling niet
  // onverwijderbaar maken.
  bundleId       String?
  bundle         ProductBundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([bundleId])
  @@map("order_items")
}

model Ticket {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  qrToken   String       @unique
  status    TicketStatus @default(UNUSED)
  checkIns  CheckIn[]
  createdAt DateTime     @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("tickets")
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  scannedBy String?
  device    String?
  scannedAt DateTime @default(now())

  @@index([ticketId])
  @@map("check_ins")
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  supabaseAuthId String        @unique
  email          String        @unique
  role           UserRole
  isActive       Boolean       @default(true)
  eventAccess    EventAccess[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@map("users")
}

// Beperkt EDITOR/DOOR_STAFF tot specifieke events (ADMIN/FINANCE blijven org-breed
// ongelimiteerd en negeren deze tabel — zie packages/core/src/auth/event-access.ts).
model EventAccess {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("event_access")
}

model EmailTemplate {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id])
  type      EmailTemplateType
  language  String            @default("nl")
  subject   String
  bodyHtml  String
  // Optioneel: welke EmailLayout deze specifieke mail omlijst. Leeg = de standaard-lay-out
  // van de organisatie (EmailLayout.isDefault), zie packages/core/src/email/get-layout.ts.
  layoutId  String?
  layout    EmailLayout?      @relation(fields: [layoutId], references: [id])
  updatedAt DateTime          @updatedAt

  @@unique([eventId, type, language])
  @@map("email_templates")
}

// Herbruikbare, org-brede mailing-inhoud (onderwerp + body + lay-out) los van een
// specifieke doelgroep/verzending — zie EmailCampaign.mailingTemplateId hieronder. Bewust
// org-breed i.p.v. event-gebonden: placeholders als {{event_naam}}/{{aantal_tickets}}/
// {{afmeldlink}} worden pas bij verzenden ingevuld (buildSegmentRecipients), dus dezelfde
// template werkt voor elk event. Niet te verwarren met EmailTemplate hierboven (dat zijn de
// automatische transactionele mails per event/type, deze zijn voor handmatige mailings).
model MailingTemplate {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  subject        String
  bodyHtml       String
  layoutId       String?
  layout         EmailLayout?    @relation(fields: [layoutId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  campaigns      EmailCampaign[]

  @@index([organizationId])
  @@map("mailing_templates")
}

// Gepersonaliseerde bulkmail naar een segment deelnemers van een event (los van de
// transactionele EmailTemplate-mails). Segment/verzendlogica: packages/core/src/email/.
// subject/bodyHtml/layoutId zijn een snapshot van het gekozen MailingTemplate op het moment
// van verzenden (niet live gekoppeld) — zo blijft een verzonden mailing historisch correct,
// ook als de template daarna wordt bewerkt of verwijderd (mailingTemplateId -> SetNull).
model EmailCampaign {
  id                String                   @id @default(cuid())
  // Korte, url-vriendelijke code voor de {{ticketlink}} (/tickets/<shortCode>, zie
  // apps/web/app/tickets/[code]/route.ts) — een leesbare/deelbare link i.p.v. de volledige
  // (lelijke) id in de URL. Losstaand van `id` zodat interne relaties (Order.mailingCampaignId)
  // altijd via de stabiele id blijven lopen, ook als de link-vorm ooit verandert. Altijd expliciet
  // meegegeven bij het aanmaken (zie createBulkCampaign) — geen @default, want we willen een
  // kort (8-teken) willekeurig token i.p.v. Prisma's langere cuid()-formaat.
  shortCode         String                   @unique
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  eventId           String
  event             Event                    @relation(fields: [eventId], references: [id])
  createdByUserId   String?
  mailingTemplateId String?
  mailingTemplate   MailingTemplate?         @relation(fields: [mailingTemplateId], references: [id], onDelete: SetNull)
  subject           String
  bodyHtml          String
  layoutId          String?
  layout            EmailLayout?             @relation(fields: [layoutId], references: [id])
  // Snapshot van de gekozen filters (event/producttype/check-in) — audit + reproduceerbaarheid.
  segment           Json
  status            EmailCampaignStatus      @default(QUEUED)
  totalRecipients   Int                      @default(0)
  sentCount         Int                      @default(0)
  failedCount       Int                      @default(0)
  skippedCount      Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  recipients        EmailCampaignRecipient[]
  attributedOrders  Order[]

  @@index([organizationId])
  @@index([eventId])
  @@map("email_campaigns")
}

// Herbruikbare "envelop" rond de per-mail inhoud (header/footer/huisstijl) — org-breed
// selecteerbaar per EmailTemplate/EmailCampaign, i.p.v. één hardcoded opmaak voor alles.
// bodyHtml is vrije HTML die verplicht één keer {{content}} bevat (waar de eigenlijke
// e-mailinhoud wordt ingevoegd); mag daarnaast dezelfde placeholders gebruiken als de
// inhoud zelf (renderWithLayout in packages/core/src/email/layout.ts doet één
// gecombineerde substitutie-pas over lay-out + inhoud).
model EmailLayout {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  bodyHtml       String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailTemplates EmailTemplate[]
  emailCampaigns EmailCampaign[]
  mailingTemplates MailingTemplate[]

  @@index([organizationId])
  @@map("email_layouts")
}

// Door het bestuur zelf te onderhouden {{placeholder}}'s (bv. {{clubadres}},
// {{telefoonnummer}}) — org-breed, vaste waarde (mag HTML bevatten, zelfde HtmlEditor als
// templates/lay-outs). Anders dan de systeem-placeholders (voornaam, event_naam, …, zie
// packages/core/src/email/placeholders.ts) die per verzending berekend worden, is dit een
// simpele sleutel/waarde-lijst zonder eigen rekenlogica — key wordt zonder de accolades
// opgeslagen ("clubadres", niet "{{clubadres}}").
model CustomPlaceholder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  valueHtml      String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("custom_placeholders")
}

// Door het bestuur aan te passen tekst voor een klein, vast setje SYSTEEM-placeholders
// die van zichzelf al (deels) vaste bewoording hadden (locatie/tickets_sectie/
// merchandise, zie packages/core/src/email/system-placeholder-overrides.ts) — anders dan
// CustomPlaceholder hierboven blijven deze wel per bestelling berekend (bv. de daadwerke-
// lijke locatienaam, of de vermelding alleen tonen als er ook echt tickets/merchandise
// zijn); alleen de omringende bewoording is hier aanpasbaar, via een `{{waarde}}`-token in
// `template` dat bij het verzenden vervangen wordt door de berekende waarde. Geen rij voor
// een key = de meegeleverde standaardtekst wordt gebruikt.
model SystemPlaceholderOverride {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  template       String
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("system_placeholder_overrides")
}

model EmailCampaignRecipient {
  id              String                       @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign                @relation(fields: [campaignId], references: [id])
  email           String
  // Personalisatie-snapshot t.t.v. samenstellen van de doelgroep (voornaam e.d.) —
  // vastgelegd nu, niet opnieuw opgezocht bij verzending, zodat een langlopende batch
  // consistent blijft ook als onderliggende orders intussen wijzigen.
  personalization Json
  status          EmailCampaignRecipientStatus @default(PENDING)
  error           String?
  sentAt          DateTime?

  @@index([campaignId, status])
  @@map("email_campaign_recipients")
}

// Bewust NIET org-gescoped: de app is in de praktijk single-tenant en een afmeldlink
// hoeft geen organizationId te bevatten om te werken. Kan later alsnog org-gescoped
// worden als multi-tenant relevant wordt.
model EmailOptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("email_opt_outs")
}

model PageBlock {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  type        String
  order       Int
  content     Json
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@map("page_blocks")
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  valueEncrypted String
  isSecret       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("audit_logs")
}
