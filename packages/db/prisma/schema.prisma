// Datamodel — zie docs/architectuurvoorstel.md voor de motivatie per keuze.
// Organization (1 rij nu) -> Event -> Product (kind: TICKET/MERCHANDISE) -> Order ->
// OrderItem -> Ticket -> CheckIn, plus User, EmailTemplate, PageBlock, Setting en AuditLog.
// Een ticket is gewoon een Product met kind=TICKET — alleen die regels genereren een
// scanbaar Ticket. Zie docs/architectuurvoorstel.md ("Fase 5 — één Product-model").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  UNUSED
  CHECKED_IN
  CANCELLED
}

enum UserRole {
  ADMIN
  FINANCE
  EDITOR
  DOOR_STAFF
}

enum EmailTemplateType {
  ORDER_CONFIRMATION
  PAYMENT_REMINDER
  PAYMENT_FAILED
  CANCELLED
}

enum ProductKind {
  TICKET
  MERCHANDISE
}

enum EmailCampaignStatus {
  QUEUED
  SENDING
  DONE
}

enum EmailCampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_OPTOUT
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  events         Event[]
  users          User[]
  settings       Setting[]
  auditLogs      AuditLog[]
  emailCampaigns EmailCampaign[]
  emailLayouts   EmailLayout[]
  createdAt      DateTime        @default(now())

  @@map("organizations")
}

model Event {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  slug           String          @unique
  name           String
  description    String?
  venue          String?
  startsAt       DateTime
  endsAt         DateTime?
  status         EventStatus     @default(DRAFT)
  // Vrije-vorm huisstijl per event (bv. { primaryColor, backgroundColor, accentColor,
  // logoUrl }) — zelfde Json-patroon als PageBlock.content, zodat een nieuwe thema-optie
  // geen migratie kost. Zie docs/architectuurvoorstel.md ("Per-event huisstijl").
  theme          Json?
  // Of dit event in de dagelijkse admin-pickers verschijnt (dashboard, e-mailtemplates,
  // paginabeheer) — los van `status`, dat de publieke zichtbaarheid regelt. `/events`
  // zelf en de bestellingen-filter tonen altijd alles, ook onzichtbare events.
  isVisible      Boolean         @default(true)
  products       Product[]
  orders         Order[]
  emailTemplates EmailTemplate[]
  emailCampaigns EmailCampaign[]
  pageBlocks     PageBlock[]
  userAccess     EventAccess[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@map("events")
}

// Een verkoopbaar artikel binnen een event. kind=TICKET-regels genereren bij betaling een
// scanbaar Ticket (QR/check-in); kind=MERCHANDISE-regels niet — die komen alleen als
// vermelding op het ticket-PDF/de bevestigingsmail. Zie docs/architectuurvoorstel.md
// ("Fase 5 — één Product-model").
model Product {
  id            String      @id @default(cuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  kind          ProductKind @default(MERCHANDISE)
  name          String
  description   String?
  imageUrl      String?
  priceCents    Int
  currency      String      @default("EUR")
  totalStock    Int
  reservedStock Int         @default(0)
  soldStock     Int         @default(0)
  isActive      Boolean     @default(true)
  orderItems    OrderItem[]
  tickets       Ticket[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventId])
  @@map("products")
}

model Order {
  id                 String      @id @default(cuid())
  eventId            String
  event              Event       @relation(fields: [eventId], references: [id])
  buyerName          String
  buyerEmail         String
  status             OrderStatus @default(PENDING)
  totalCents         Int
  currency           String      @default("EUR")
  molliePaymentId    String?     @unique
  stockHoldExpiresAt DateTime?
  isVisible          Boolean     @default(true)
  items              OrderItem[]
  tickets            Ticket[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([eventId])
  @@index([status, stockHoldExpiresAt])
  @@index([isVisible])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Ticket {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  qrToken   String       @unique
  status    TicketStatus @default(UNUSED)
  checkIns  CheckIn[]
  createdAt DateTime     @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("tickets")
}

model CheckIn {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  scannedBy String?
  device    String?
  scannedAt DateTime @default(now())

  @@index([ticketId])
  @@map("check_ins")
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  supabaseAuthId String        @unique
  email          String        @unique
  role           UserRole
  isActive       Boolean       @default(true)
  eventAccess    EventAccess[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@map("users")
}

// Beperkt EDITOR/DOOR_STAFF tot specifieke events (ADMIN/FINANCE blijven org-breed
// ongelimiteerd en negeren deze tabel — zie packages/core/src/auth/event-access.ts).
model EventAccess {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("event_access")
}

model EmailTemplate {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id])
  type      EmailTemplateType
  language  String            @default("nl")
  subject   String
  bodyHtml  String
  // Optioneel: welke EmailLayout deze specifieke mail omlijst. Leeg = de standaard-lay-out
  // van de organisatie (EmailLayout.isDefault), zie packages/core/src/email/get-layout.ts.
  layoutId  String?
  layout    EmailLayout?      @relation(fields: [layoutId], references: [id])
  updatedAt DateTime          @updatedAt

  @@unique([eventId, type, language])
  @@map("email_templates")
}

// Gepersonaliseerde bulkmail naar een segment deelnemers van een event (los van de
// transactionele EmailTemplate-mails). Segment/verzendlogica: packages/core/src/email/.
model EmailCampaign {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id])
  eventId         String
  event           Event                    @relation(fields: [eventId], references: [id])
  createdByUserId String?
  subject         String
  bodyHtml        String
  layoutId        String?
  layout          EmailLayout?             @relation(fields: [layoutId], references: [id])
  // Snapshot van de gekozen filters (event/producttype/check-in) — audit + reproduceerbaarheid.
  segment         Json
  status          EmailCampaignStatus      @default(QUEUED)
  totalRecipients Int                      @default(0)
  sentCount       Int                      @default(0)
  failedCount     Int                      @default(0)
  skippedCount    Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  recipients      EmailCampaignRecipient[]

  @@index([organizationId])
  @@index([eventId])
  @@map("email_campaigns")
}

// Herbruikbare "envelop" rond de per-mail inhoud (header/footer/huisstijl) — org-breed
// selecteerbaar per EmailTemplate/EmailCampaign, i.p.v. één hardcoded opmaak voor alles.
// bodyHtml is vrije HTML die verplicht één keer {{content}} bevat (waar de eigenlijke
// e-mailinhoud wordt ingevoegd); mag daarnaast dezelfde placeholders gebruiken als de
// inhoud zelf (renderWithLayout in packages/core/src/email/layout.ts doet één
// gecombineerde substitutie-pas over lay-out + inhoud).
model EmailLayout {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  bodyHtml       String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailTemplates EmailTemplate[]
  emailCampaigns EmailCampaign[]

  @@index([organizationId])
  @@map("email_layouts")
}

model EmailCampaignRecipient {
  id              String                       @id @default(cuid())
  campaignId      String
  campaign        EmailCampaign                @relation(fields: [campaignId], references: [id])
  email           String
  // Personalisatie-snapshot t.t.v. samenstellen van de doelgroep (voornaam e.d.) —
  // vastgelegd nu, niet opnieuw opgezocht bij verzending, zodat een langlopende batch
  // consistent blijft ook als onderliggende orders intussen wijzigen.
  personalization Json
  status          EmailCampaignRecipientStatus @default(PENDING)
  error           String?
  sentAt          DateTime?

  @@index([campaignId, status])
  @@map("email_campaign_recipients")
}

// Bewust NIET org-gescoped: de app is in de praktijk single-tenant en een afmeldlink
// hoeft geen organizationId te bevatten om te werken. Kan later alsnog org-gescoped
// worden als multi-tenant relevant wordt.
model EmailOptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("email_opt_outs")
}

model PageBlock {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  type        String
  order       Int
  content     Json
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@map("page_blocks")
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  valueEncrypted String
  isSecret       Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("audit_logs")
}
