# Supabase (client-safe — gedeeld door web/admin/scanner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only secrets — nooit naar de clientbundle)
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Postgres (Supabase connection strings — Dashboard > Connect > ORM > Prisma)
# DATABASE_URL = transaction pooler (poort 6543) + ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = session pooler / directe connectie (poort 5432), alleen voor `prisma migrate`
# Let op: als het databasewachtwoord tekens als @ # % / : $ bevat, moeten die
# URL-encoded worden (bv. # -> %23, / -> %2F) anders breekt de connection string af
# bij het eerste speciale teken.
DATABASE_URL=
DIRECT_URL=

# Versleuteling van Setting.valueEncrypted (o.a. Mollie live/test-keys) — AES-256-GCM
SETTINGS_ENCRYPTION_KEY=

# HMAC-secret voor het ondertekenen van ticket-QR-tokens
TICKET_QR_SECRET=

# Mollie — alleen als lokale/dev-default; live-keys horen in de Setting-tabel via de
# admin-UI, niet hier.
MOLLIE_TEST_API_KEY=

# Vercel Cron: geheim dat de cron-route verwacht in de Authorization-header
# (Vercel stuurt dit automatisch mee als deze env var op het project staat).
CRON_SECRET=

# Upstash QStash (achtergrondtaken: e-mailverzending, Mollie-webhookverwerking)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend (transactionele e-mail)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Basis-URLs per app (voor links in e-mails, webhook-callbacks, CORS)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SCANNER_URL=http://localhost:3002
